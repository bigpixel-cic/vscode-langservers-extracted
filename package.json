{
  "name": "vscode-langservers-extracted",
  "version": "0.1.0",
  "description": "Just a fork of the original. Nothing to see here.",
  "main": "index.js",
  "files": [
    "lib/",
    "bin/"
  ],
  "directories": {
    "bin": "./bin"
  },
  "bin": {
    "vscode-css-language-server": "bin/vscode-css-language-server",
    "vscode-eslint-language-server": "bin/vscode-eslint-language-server",
    "vscode-html-language-server": "bin/vscode-html-language-server",
    "vscode-json-language-server": "bin/vscode-json-language-server",
    "vscode-markdown-language-server": "bin/vscode-markdown-language-server"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bigpixel-cic/vscode-langservers-extracted.git"
  },
  "keywords": [
    "language-server-protocol"
  ],
  "scripts": {
    "clean": "rimraf {lib,dist}/*",
    "update": "pnpm clean && ./script/build.sh && node ./script/depcheck.js",
    "release": "np --no-pnpm",
    "test": "echo 1"
  },
  "author": "James",
  "license": "MIT",
  "devDependencies": {
    "@babel/cli": "^8.0.5",
    "@babel/core": "^8.0.5",
    "@babel/preset-env": "^8.0.5",
    "np": "^12.1.1",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.3"
  },
  "dependencies": {
    "@vscode/l10n": "^0.0.18",
    "core-js": "^3.50.0",
    "jsonc-parser": "^3.3.1",
    "regenerator-runtime": "^0.14.1",
    "request-light": "^0.8.0",
    "semver": "^7.8.5",
    "typescript": "^7.0.2",
    "vscode-css-languageservice": "^6.3.10",
    "vscode-html-languageservice": "^5.6.2",
    "vscode-json-languageservice": "^5.7.2",
    "vscode-languageserver": "^10.1.1",
    "vscode-languageserver-textdocument": "^1.0.14",
    "vscode-languageserver-types": "^3.18.3",
    "vscode-markdown-languageservice": "^0.5.0",
    "vscode-nls": "^5.2.0",
    "vscode-uri": "^3.2.0"
